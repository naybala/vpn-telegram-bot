# ==================================================================
# 🤖 TELEGRAM BOT
# ==================================================================
BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Telegram User ID (numeric) — only this user can run /generate
USER_ID=xxxxxx

# Group ID (numeric, negative number) — payment notifications are sent here
# To get it: add @userinfobot to your group, it will show the group ID
GROUP_ID=xxxxxxxxxxxx

# ==================================================================
# 🗄️ MYSQL DATABASE
# ==================================================================
DB_HOST=localhost
DB_USER=root
DB_PASS=xxxxxxxxxxxxx
DB_NAME=xxxxx

# ==================================================================
# 🌐 OUTLINE VPN SERVERS
# Comma-separated list of Outline API URLs (one per server)
# Example: https://1.2.3.4:12345/secret,https://5.6.7.8:12345/secret
# ==================================================================
API_URLS=https://thailand-server-ip:port/api-secret,https://singapore-server-ip:port/api-secret

# Server display names (matching order of API_URLS above)
SERVER_NAMES=Thailand 🇹🇭,Singapore 🇸🇬

# Server pricing (matching order of API_URLS above)
SERVER_PRICES=7000 Ks,10000 Ks

# ==================================================================
# 🌍 DNS HOSTNAMES (Optional, per-server)
# Comma-separated list matching the order of API_URLS above.
# Leave a slot EMPTY to keep raw IP for that server.
#
# Examples:
#   Both servers use DNS:   DNS_HOSTNAMES=th.domain.com,sg.domain.com
#   Only server 1 uses DNS: DNS_HOSTNAMES=th.domain.com,
#   Only server 2 uses DNS: DNS_HOSTNAMES=,sg.domain.com
#   No DNS at all:          DNS_HOSTNAMES=   (or omit the line entirely)
# ==================================================================
DNS_HOSTNAMES=th.domain.com,sg.domain.com


# ==================================================================
# 💳 PAYMENT & CONTACT INFO
# Add/remove payment methods by including or omitting their variables.
# A method is only shown to users if its PHONE_NUMBER is set.
# ==================================================================
KPAY_PHONE_NUMBER=xxxxxxxxxxxx
KPAY_OWNER=xxxxxxxxxxxx

AYAPAY_PHONE_NUMBER=xxxxxxxxxxxx
AYAPAY_OWNER=xxxxxxxxxxxx

CBPAY_PHONE_NUMBER=xxxxxxxxxxxx
CBPAY_OWNER=xxxxxxxxxxxx

ADMIN_ACCOUNT=@xxxxxx


# ==================================================================
# 📅 SUBSCRIPTION PLAN
# ==================================================================
# How many days a generated VPN key lasts (default: 30)
PLAN_DAYS=30
CREDIT_VALUE=500     # Ks value per referral credit (default: 500)

# How many days before expiry to warn the user (default: 3)
WARN_DAYS_BEFORE=3


